# Server Configuration
PORT=5000

# PostgreSQL 17 Database Configuration
# Note: Check your pgAdmin connection settings. If your PostgreSQL 17 is on port 5433, use 5433; if default, use 5432.
PGHOST=localhost
PGPORT=5433
PGDATABASE=need_analysis_poc
PGUSER=postgres
PGPASSWORD=your_postgres_password_here
PGSSL=false

# Connection Pool Configuration
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=5000

# Optional: Google Gemini API Key for Live AI Advisor Insights (if omitted, deterministic engine is used)
GEMINI_API_KEY=

